#diamond pattern
n=5
#upper half
for i in range(1,n+1): 
    for j in range(1,n-i+1):
        print(" ", end="")
    for k in range(1,2*i):
        print("*", end="")
    print()
#lower half
for i in range(1,n):
    for j in range(1,i+1):
        print(" ", end="")
    for k in range(1,2*(n-i)):
        print("*", end="")
    print()